# ==============================================================================
# ARCHITECTURAL SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# File: .env.example
# Role: Defines the required and optional environment variables for the AI Agent OS,
#       including multi-provider LLM fallbacks, diagnostic engines, PII sanitization,
#       and database persistence layers.
# Connections: Loaded by the system kernel, diagnostic engines, and database adapters.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & PERSISTENCE LAYER
# ------------------------------------------------------------------------------
# Primary database connection URL (e.g., SQLite, PostgreSQL, MySQL)
DATABASE_URL="file:./dev.db"

# Flat-file memory directory path for local agent persistence
MEMORY_PERSISTENCE_DIR="./memory"

# Redis cache configuration for distributed state and rate limiting (optional)
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 2. MULTI-PROVIDER LLM FALLBACK CONFIGURATIONS
# ------------------------------------------------------------------------------
# Active primary LLM provider (Options: gemini, openai, deepseek, local, anthropic)
PRIMARY_LLM_PROVIDER="gemini"

# Google Gemini API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-pro"

# OpenAI API Configuration (Fallback 1)
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o"

# DeepSeek API Configuration (Fallback 2)
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
DEEPSEEK_MODEL="deepseek-chat"

# Anthropic API Configuration (Fallback 3)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# Local LLM / Ollama Configuration (Fallback 4 / Offline Mode)
LOCAL_LLM_ENDPOINT="http://localhost:11434/v1"
LOCAL_LLM_MODEL="llama3"

# ------------------------------------------------------------------------------
# 3. DIAGNOSTIC & TELEMETRY ENGINE SETTINGS
# ------------------------------------------------------------------------------
# Diagnostic execution level (Options: DEBUG, INFO, WARNING, ERROR, CRITICAL)
DIAGNOSTIC_LOG_LEVEL="INFO"

# Enable strict gatekeeper policy (blocks execution if diagnostics fail)
DIAGNOSTIC_STRICT_GATEKEEPER="true"

# Telemetry reporting endpoint (optional)
TELEMETRY_ENDPOINT="https://telemetry.agent-os.local/v1/metrics"
TELEMETRY_ENABLED="false"

# ------------------------------------------------------------------------------
# 4. SECURITY & PII SANITIZATION (Git-Secret-PII-Sanitizer)
# ------------------------------------------------------------------------------
# Enable automatic PII and secret sanitization on agent outputs and git commits
PII_SANITIZER_ENABLED="true"

# Custom regex patterns for PII detection (comma-separated list of regexes or rule names)
PII_CUSTOM_RULES="CREDIT_CARD,EMAIL,IP_ADDRESS,SSN"

# Encryption key for securing local flat-file memory blocks (32-byte hex string)
MEMORY_ENCRYPTION_KEY="000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"

# ------------------------------------------------------------------------------
# 5. SYSTEM KERNEL & MODULE LOADER
# ------------------------------------------------------------------------------
# Kernel execution environment (Options: development, production, test)
NODE_ENV="development"

# Port for the local agent kernel API server
PORT=3000

# Module loader dynamic path
MODULE_LOADER_PATH="./modules"
