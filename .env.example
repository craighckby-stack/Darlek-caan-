# ==============================================================================
# ARCHITECTURAL SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# File: .env.example
# Role: Defines the required and optional environment variables for the AI Agent OS,
#       including multi-provider LLM fallbacks, diagnostic engines, PII sanitization,
#       and database persistence layers.
# Connections: Loaded by the system kernel, diagnostic engines, and database adapters.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE, VECTOR STORE & RAG PERSISTENCE
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
MEMORY_PERSISTENCE_DIR="./memory"
REDIS_URL="redis://localhost:6379"
VECTOR_DB_PROVIDER="in-memory"
VECTOR_DB_ENDPOINT="http://localhost:8000"
VECTOR_DB_API_KEY="your_vector_db_api_key_here"
GRAPHRAG_INDEX_PATH="./storage/graphrag"

# ------------------------------------------------------------------------------
# 2. MULTI-PROVIDER LLM FALLBACK & CONSENSUS ORCHESTRATION
# ------------------------------------------------------------------------------
PRIMARY_LLM_PROVIDER="gemini"
LLM_FALLBACK_CHAIN="gemini,openai,deepseek,anthropic,local"
CONSENSUS_VOTING_ENABLED="false"
CONSENSUS_THRESHOLD="0.7"
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-pro"
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
DEEPSEEK_MODEL="deepseek-chat"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
LOCAL_LLM_ENDPOINT="http://localhost:11434/v1"
LOCAL_LLM_MODEL="llama3"
LLM_TEMPERATURE="0.7"
LLM_MAX_TOKENS="4096"

# ------------------------------------------------------------------------------
# 3. DIAGNOSTIC, TELEMETRY & GATEKEEPER ENGINE SETTINGS
# ------------------------------------------------------------------------------
# Diagnostic execution level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DIAGNOSTIC_LOG_LEVEL="INFO"
# Enable strict gatekeeper policy (blocks execution if diagnostics fail)
DIAGNOSTIC_STRICT_GATEKEEPER="true"
# Interval for background system health checks (in milliseconds)
DIAGNOSTIC_CHECK_INTERVAL_MS="60000"
# Telemetry reporting endpoint
TELEMETRY_ENDPOINT="https://telemetry.agent-os.local/v1/metrics"
TELEMETRY_ENABLED="false"
# Observability integration (Prometheus/Grafana)
OBSERVABILITY_METRICS_PORT="9090"

# ------------------------------------------------------------------------------
# 4. SECURITY, ZERO-LEAK SANDBOXING & PII SANITIZATION
# ------------------------------------------------------------------------------
PII_SANITIZER_ENABLED="true"
PII_CUSTOM_RULES="CREDIT_CARD,EMAIL,IP_ADDRESS,SSN"
MEMORY_ENCRYPTION_KEY="000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
SANDBOX_ENABLED="true"
SANDBOX_TIMEOUT_MS="5000"
SANDBOX_MEMORY_LIMIT_MB="128"

# ------------------------------------------------------------------------------
# 5. SYSTEM KERNEL, MODULE LOADER & MULTI-AGENT ORCHESTRATION
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
HOST="127.0.0.1"
MODULE_LOADER_PATH="./modules"
MAX_CONCURRENT_TASKS="10"

# ------------------------------------------------------------------------------
# 6. DIAGNOSTIC-AWARE SYSTEM INTEGRITY KEYS
# ------------------------------------------------------------------------------
# Used by the DiagnosticGatekeeper to verify environment integrity
SYSTEM_INTEGRITY_HASH="sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"