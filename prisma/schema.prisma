/**
 * PRISMA SCHEMA: DARLEK CANN AGI PERSISTENCE LAYER
 * Role: Defines the core data structures for the evolution engine, 
 * diagnostic telemetry, and mutation history tracking.
 * Integration: Connects to the DiagnosticEngine and MutationPatching pipelines.
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// BRAIN — DARLEK CANN AGI Persistence Layer

model Session {
  id            String    @id @default(cuid())
  branch        String    @default("ALPHA")
  status        String    @default("active")
  overallHealth String    @default("healthy")
  evolutionCycle Int      @default(0)
  mutationsApplied Int    @default(0)
  mutationsRejected Int    @default(0)
  startedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  mutations     MutationHistory[]
  rejections    RejectionRecord[]
  healthChecks  HealthSnapshot[]
  telemetry     SystemTelemetry[]
}

model MutationHistory {
  id            String   @id @default(cuid())
  sessionId     String
  filePath      String
  fileSha       String   @default("")
  originalCode  String
  proposedCode  String
  analysis      String
  riskScore     Int
  affectedFiles String   @default("[]")
  status        String   @default("pending")
  commitSha     String   @default("")
  provider      String   @default("")
  debateResult  String   @default("")
  impactResult  String   @default("")
  errorMessage  String   @default("")
  createdAt     DateTime @default(now())
  session       Session  @relation(fields: [sessionId], references: [id])
}

model RejectionRecord {
  id            String   @id @default(cuid())
  sessionId     String
  filePath      String
  reason        String
  analysis      String
  riskScore     Int
  patternTags   String   @default("[]")
  createdAt     DateTime @default(now())
  session       Session  @relation(fields: [sessionId], references: [id])
}

model HealthSnapshot {
  id                 String   @id @default(cuid())
  sessionId          String
  structuralChange   Float    @default(0)
  semanticSaturation Float    @default(0)
  velocity           Float    @default(0)
  identityPreservation Float  @default(1)
  capabilityAlignment  Float  @default(0)
  crossFileImpact    Float    @default(0)
  overallHealth      String   @default("healthy")
  createdAt          DateTime @default(now())
  session            Session  @relation(fields: [sessionId], references: [id])
}

model SystemTelemetry {
  id            String   @id @default(cuid())
  sessionId     String
  checkType     String
  passed        Boolean
  durationMs    Float
  timestamp     DateTime @default(now())
  session       Session  @relation(fields: [sessionId], references: [id])
}

model DiagnosticGatekeeperLog {
  id            String   @id @default(cuid())
  reportStatus  String
  isHealthy     Boolean
  passRate      Float
  createdAt     DateTime @default(now())
}